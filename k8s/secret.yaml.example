apiVersion: v1
kind: Secret
metadata:
  name: django-secrets
  namespace: default
type: Opaque
data:
  ALLOWED_HOSTS: Kg== # '*' in Base64
  DEBUG: VHJ1ZQ==     # 'True' in Base64
  POSTGRES_HOST: ""
  POSTGRES_NAME: ""
  POSTGRES_PASSWORD: "" # Put your own Base64 password here
  POSTGRES_PORT: ""
  POSTGRES_USER: ""
  SECRET_KEY: ""        # Put your own Base64 secret key here

